# ==============================================================================
# PentiumPOS - Backend Environment Variables
# ==============================================================================
# Copia este archivo como .env y configura los valores según tu entorno.
# NUNCA subas el archivo .env real a git (ya está en .gitignore)
# ==============================================================================

# ------------------------------------------------------------------------------
# REQUIRED - El sistema NO arranca sin estas variables
# ------------------------------------------------------------------------------

# URL de conexión a MySQL
# Formato: mysql://USUARIO:PASSWORD@HOST:PUERTO/BASE_DE_DATOS
# PRODUCTION: Use a strong password, not root:1234
DATABASE_URL="mysql://root:1234@localhost:3306/pentiumpos"

# Secreto para firmar JWT tokens
# GENERATE with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# The server will REFUSE TO START in production with the default value below.
JWT_SECRET="dev_only_jwt_secret_replace_in_production_abc123"

# ------------------------------------------------------------------------------
# OPTIONAL - Tienen valores por defecto
# ------------------------------------------------------------------------------

# Puerto del servidor (default: 3001)
PORT=3001

# Orígenes CORS permitidos (separados por coma)
# En desarrollo: http://localhost:5173
# En producción: https://tudominio.com
CORS_ORIGINS="http://localhost:5173"

# Entorno de ejecución: development | production | test
# Afecta: rate limiting, logging verbose, errores detallados
NODE_ENV="development"

# Nivel de logging: debug | info | warn | error
LOG_LEVEL="info"

# ------------------------------------------------------------------------------
# REDIS & QUEUE - Required for delivery integrations and async processing
# ------------------------------------------------------------------------------

# Redis host for BullMQ queue system
REDIS_HOST="localhost"

# Redis port
REDIS_PORT="6379"

# Redis password - REQUIRED: Must match --requirepass in docker-compose
# Development default: devpassword123 (matches docker-compose.yml)
# Production: generate a strong random password
REDIS_PASSWORD="devpassword123"

# Enable queue workers (set to 'true' to process webhooks)
ENABLE_QUEUE_WORKERS="false"

# ------------------------------------------------------------------------------
# TUNING - Performance and timeout configuration (CFG-004)
# ------------------------------------------------------------------------------

# Lock acquisition timeout for SELECT FOR UPDATE (ms, default: 5000)
# LOCK_TIMEOUT_MS="5000"

# Transaction timeout (ms, default: 10000)
# TRANSACTION_TIMEOUT_MS="10000"

# Feature flags cache TTL (ms, default: 60000)
# FEATURE_FLAGS_CACHE_TTL_MS="60000"

# Idempotency cache TTL (seconds, default: 300)
# IDEMPOTENCY_CACHE_TTL_SECONDS="300"

# ------------------------------------------------------------------------------
# LOYALTY - Points configuration (BIZ-014)
# ------------------------------------------------------------------------------

# Points earned per dollar spent (default: 10)
# LOYALTY_POINTS_PER_DOLLAR="10"

# Points needed for $1 discount (default: 100)
# LOYALTY_POINTS_REDEEM_VALUE="100"

# ------------------------------------------------------------------------------
# SEED DATA - Solo para desarrollo/testing
# ------------------------------------------------------------------------------

# PIN del usuario admin al ejecutar seed
# IMPORTANTE: Cambiar después de crear usuario admin
SEED_ADMIN_PIN="999999"
